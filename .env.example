# --- Cognito (Hosted UI / login redirigido) ---
# User Pool ID y App Client ID (el App Client debe ser PÚBLICO: sin client secret)
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Dominio de Cognito, SIN https:// (Cognito > App integration > Domain)
VITE_COGNITO_DOMAIN=mi-prefijo.auth.us-east-1.amazoncognito.com
# A dónde vuelve el usuario tras login/logout. Debe ser IDÉNTICA (con "/" final)
# a la registrada en Cognito > App client > Managed login pages > Allowed callback URLs
VITE_REDIRECT_URL=http://localhost:5173/

# --- API Gateway ---
# Invoke URL de tu API Gateway (sin "/" final). Ej: https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
